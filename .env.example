# =============================================================================
# CELPIP-General Practice Platform — environment variable NAMES only.
# Copy to backend/.env (or export in your shell) and fill in real values.
# Never commit real secrets. This file documents names, not values.
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────
# Selects the active settings module. Defaults to config.settings.dev.
# Use config.settings.prod in deployed environments (it enforces SECRET_KEY,
# ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, DATABASE_URL, TLS/HSTS, and secure cookies).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. A development fallback is used when unset in dev.
SECRET_KEY=

# "true" / "false". Defaults to false (safe). dev settings force this on.
DEBUG=true

# Comma-separated hostnames permitted to serve the app.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── TLS / security headers (production) ──────────────────────────────────
# Redirect plain HTTP to HTTPS. Default true in prod settings.
SECURE_SSL_REDIRECT=
# Trust the X-Forwarded-Proto header from a reverse proxy. Only enable this
# when the proxy strips any inbound X-Forwarded-Proto header first.
TRUST_PROXY_SSL_HEADER=
# HSTS max-age in seconds; defaults to 31536000 (one year) in prod.
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=

# ── Request / correlation IDs & logging ──────────────────────────────────
# Header names surfaced on every response and read from inbound requests.
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
# Log level (DEBUG/INFO/WARNING/ERROR) and format ("plain" or "json").
LOG_LEVEL=INFO
LOG_FORMAT=plain

# ── Database ─────────────────────────────────────────────────────────────
# A full database URL, e.g. postgres://user:password@localhost:5432/celpip
# When empty/unset, the backend automatically falls back to a local SQLite
# file (backend/db.sqlite3) for development and tests. Production
# (config.settings.prod) refuses to start without a real DATABASE_URL.
DATABASE_URL=

# Private audio/recording root. This directory must not be served as public
# static or media content. Defaults to backend/private_media in development.
PRIVATE_MEDIA_ROOT=

# Practice-content bootstrap on container start (see start.sh). When seeding
# runs, the entrypoint stages the bundled Listening audio into
# PRIVATE_MEDIA_ROOT and runs the four idempotent seed commands
# (reading/listening/writing/speaking); any failure aborts startup.
#   auto (default, or unset) — seed only when the database has no published
#                              content, so a fresh deploy heals itself and
#                              ordinary restarts skip straight to Gunicorn.
#   true                     — always run the seeds (idempotent, just slower).
#   false                    — never seed; content is managed by hand.
BOOTSTRAP_CONTENT_ON_START=auto

# ── CORS (frontend origin) ───────────────────────────────────────────────
# Comma-separated origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Authentication cookies / CSRF ────────────────────────────────────────
# The refresh token is stored in an HttpOnly cookie scoped to the auth
# endpoints. "Secure" defaults to on outside DEBUG; leave AUTH_COOKIE_SECURE
# unset in dev (http) and it will be off automatically.
AUTH_REFRESH_COOKIE_NAME=celpip_refresh
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=
# Comma-separated origins Django trusts for CSRF (needed for cross-origin POST
# in production). Same-origin dev via the Vite proxy does not need this.
CSRF_TRUSTED_ORIGINS=

# ── Auth throttling (DRF rates) ──────────────────────────────────────────
# Optional overrides for the default per-endpoint throttle rates.
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTER=10/hour
THROTTLE_AUTH_RECOVERY=10/hour

# ── Owner bootstrap ──────────────────────────────────────────────────────
# Read by `manage.py bootstrap_owner` when --password is not supplied.
OWNER_PASSWORD=

# ── Audited AI services ────────────────────────────────────────────────
# Use "fake" for deterministic local development or "openai" for live jobs.
# Generated questions are always saved as drafts and require staff review.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-2
AI_MAX_ATTEMPTS=3
AI_JOB_POLL_SECONDS=2

# ── Listening audio synthesis (text-to-speech) ───────────────────────────
# Stored CELPIP-General Listening audio is generated ONCE and reused. The
# regeneration command (see below) tries these providers in order until one
# returns a valid WAV. This order is intentionally INDEPENDENT of AI_PROVIDER:
# general AI evaluation can stay on "fake" while listening audio uses a live
# speech vendor. "local" is the terminal fallback that RETAINS the existing
# validated recording, so a working file is never overwritten when every
# upstream provider is unavailable or fails.
LISTENING_TTS_PROVIDER_ORDER=openai,azure,local

# OpenAI natural TTS (first). Reuses server-side OPENAI_API_KEY + OPENAI_TTS_MODEL
# above. Two distinct voices give dialogue scripts two clean speakers — a female
# (coral) and male (ash) voice so conversations sound naturally mixed. Valid
# voices include alloy, ash, ballad, coral, echo, fable, onyx, nova, sage,
# shimmer, verse, marin, and cedar. Keys stay on the server and never enter
# audio metadata/provenance.
LISTENING_OPENAI_VOICES=coral,ash

# Set true to force re-synthesis of ALL listening audio on the next deploy using
# the voices/model above (e.g. after changing LISTENING_OPENAI_VOICES). Audio
# already produced by OpenAI/Azure is otherwise left untouched, so a voice change
# only takes effect for existing content when this is true for one deploy. Set it
# back to false (or remove it) afterwards so startup stays fast and cheap.
FORCE_REGENERATE_LISTENING_AUDIO=false

# Azure Speech neural TTS (second). Server-side key + region only; official REST
# endpoint returns RIFF PCM WAV. Canadian English voices by default.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
LISTENING_AZURE_VOICES=en-CA-ClaraNeural,en-CA-LiamNeural

# Cost/free-tier caveat: OpenAI TTS and Azure Speech are PAID, metered per
# character. Azure offers a limited monthly free tier; OpenAI does not. Leaving
# both credential sets empty keeps the pipeline on "local" (retain existing) at
# no cost. Generated audio is SYNTHETIC and UNOFFICIAL — never an official CELPIP
# recording. Old stored WAVs remain in use until you actively regenerate them:
#
#   # Preview the plan without calling any provider or writing any file:
#   python manage.py regenerate_listening_audio --dry-run
#   # Regenerate one set (or omit --slug for all); --force resynthesizes even
#   # when the current recording is already valid:
#   python manage.py regenerate_listening_audio --slug apartment-heating-plan --force
#   python manage.py regenerate_listening_audio --force
#
# Separate per-provider renditions are generated with a DIFFERENT command so the
# canonical WAV above is never replaced. Each rendition is stored at its own
# deterministic private path (listening_renditions/{provider}/{canonical-id}.wav)
# and can be produced for openai and/or azure only — never the local fallback:
#
#   python manage.py generate_listening_renditions --provider openai --dry-run
#   python manage.py generate_listening_renditions --provider openai,azure --force
#   python manage.py generate_listening_renditions --provider openai --slug apartment-heating-plan
#
# The first local recording is produced on Windows by
# scripts/generate-listening-audio.ps1 (documented as the final fallback).

# ── Frontend ─────────────────────────────────────────────────────────────
# Base URL the SPA uses to reach the API. In dev the Vite proxy handles /api,
# so this is usually left as the default relative path.
VITE_API_BASE_URL=/api/v1
