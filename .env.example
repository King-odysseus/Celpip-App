# =============================================================================
# CELPIP-General Practice Platform — environment variable NAMES only.
# Copy to backend/.env (or export in your shell) and fill in real values.
# Never commit real secrets. This file documents names, not values.
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────
# Selects the active settings module. Defaults to config.settings.dev.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. A development fallback is used when unset in dev.
SECRET_KEY=

# "true" / "false". Defaults to false (safe). dev settings force this on.
DEBUG=true

# Comma-separated hostnames permitted to serve the app.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────
# A full database URL, e.g. postgres://user:password@localhost:5432/celpip
# When empty/unset, the backend automatically falls back to a local SQLite
# file (backend/db.sqlite3). PostgreSQL is supported for later phases.
DATABASE_URL=

# ── CORS (frontend origin) ───────────────────────────────────────────────
# Comma-separated origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Authentication cookies / CSRF ────────────────────────────────────────
# The refresh token is stored in an HttpOnly cookie scoped to the auth
# endpoints. "Secure" defaults to on outside DEBUG; leave AUTH_COOKIE_SECURE
# unset in dev (http) and it will be off automatically.
AUTH_REFRESH_COOKIE_NAME=celpip_refresh
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=
# Comma-separated origins Django trusts for CSRF (needed for cross-origin POST
# in production). Same-origin dev via the Vite proxy does not need this.
CSRF_TRUSTED_ORIGINS=

# ── Auth throttling (DRF rates) ──────────────────────────────────────────
# Optional overrides for the default per-endpoint throttle rates.
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTER=10/hour
THROTTLE_AUTH_RECOVERY=10/hour

# ── Owner bootstrap ──────────────────────────────────────────────────────
# Read by `manage.py bootstrap_owner` when --password is not supplied.
OWNER_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────────────────
# Base URL the SPA uses to reach the API. In dev the Vite proxy handles /api,
# so this is usually left as the default relative path.
VITE_API_BASE_URL=/api/v1
