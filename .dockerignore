# Keep the build context small and free of secrets, local state, and artifacts
# that the image rebuilds itself. Source, manifests, and lockfiles are kept.

# ── Version control / CI ──────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── Secrets / environment ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.eggs/
**/.venv/
**/venv/
**/env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ── Local database / collected assets / media (rebuilt or runtime-only) ────
**/db.sqlite3
**/db.sqlite3-journal
backend/staticfiles/
backend/media/
backend/spa/

# private_media is runtime-only, EXCEPT the reviewed Listening WAVs, which the
# image bundles so start.sh can stage them into PRIVATE_MEDIA_ROOT when
# the entrypoint seeds a fresh database (seed_listening_content reads them). Exclude
# the contents, then re-include only the .wav files (a parent dir cannot be
# excluded outright or the negation below could not re-include its files).
backend/private_media/*
!backend/private_media/listening
backend/private_media/listening/*
!backend/private_media/listening/*.wav

# ── Node / frontend build output (the image rebuilds these) ───────────────
**/node_modules/
frontend/dist/
frontend/coverage/
**/.vite/
**/*.tsbuildinfo

# ── Local runtime / logs / editors / OS ───────────────────────────────────
.runtime/
*.log
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Docs / tooling not needed in the image ────────────────────────────────
docs/
scripts/
